# ═══════════════════════════════════════════════════════════════
#  LoanFlow – Environment Configuration
#  Copy this file to .env and fill in your real values.
# ═══════════════════════════════════════════════════════════════

# ───────────── Supabase (Database + Storage) ─────────────
# Get these from: Supabase Dashboard → Settings → Database / API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ───────────── Upstash Redis ─────────────
# Get these from: Upstash Console → Redis → your-database
UPSTASH_REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379
UPSTASH_REDIS_TOKEN=your-rest-token

# ───────────── Auth / JWT ─────────────
JWT_SECRET=change-me-to-a-real-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CSRF_SECRET=change-me-csrf-secret

# ───────────── Supabase Storage ─────────────
STORAGE_BUCKET=loanflow-docs

# ───────────── Service URLs (local dev) ─────────────
AUTH_SERVICE_URL=http://localhost:8001
LOAN_APP_SERVICE_URL=http://localhost:8002
DOCUMENT_SERVICE_URL=http://localhost:8003
KYC_SERVICE_URL=http://localhost:8004
RISK_SERVICE_URL=http://localhost:8005
AUDIT_SERVICE_URL=http://localhost:8006

# ───────────── Frontend ─────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ───────────── Deployment ─────────────
# Gateway: comma-separated allowed browser origins (your Vercel URL)
CORS_ORIGINS=http://localhost:3000
NOTIFICATION_SERVICE_URL=http://localhost:8007
# Frontend (Vercel): same-origin proxy to the gateway
# NEXT_PUBLIC_API_BASE_URL=/api
# BACKEND_URL=https://loanflow-gateway.onrender.com
